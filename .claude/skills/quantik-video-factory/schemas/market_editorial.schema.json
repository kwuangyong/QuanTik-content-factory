{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quantik/market_editorial.schema.json",
  "title": "Market editorial",
  "description": "Đầu ra của Market Intelligence Analyst: nhận định + 3 kịch bản có điều kiện xác nhận/vô hiệu.",
  "type": "object",
  "required": [
    "report",
    "author",
    "interpretations",
    "scenarios"
  ],
  "properties": {
    "report": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "based_on"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "based_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "confirmation",
          "invalidation",
          "investor_actions"
        ],
        "properties": {
          "name": {
            "enum": [
              "bull",
              "base",
              "bear"
            ]
          },
          "description": {
            "type": "string"
          },
          "confirmation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "invalidation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "investor_actions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "hành động quản trị rủi ro chung, không nêu mã"
          },
          "subjective_probability": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
